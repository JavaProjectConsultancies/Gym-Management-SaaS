/* ------------------------------------------------------------------ */
/* Runtime configuration                                               */
/* ------------------------------------------------------------------ */

/**
 * Read and validate runtime configuration from Script Properties.
 * Throws a 500 ApiError (details logged, not returned) when misconfigured.
 */
function getConfig_() {
  const props = PropertiesService.getScriptProperties().getProperties();
  const missing = [
    PROPERTY_KEYS.SPREADSHEET_ID,
    PROPERTY_KEYS.FIREBASE_PROJECT_ID,
    PROPERTY_KEYS.FIREBASE_WEB_API_KEY,
  ].filter(function (key) {
    return !props[key] || !String(props[key]).trim();
  });

  if (missing.length > 0) {
    console.error('Backend misconfigured. Missing Script Properties: ' + missing.join(', '));
    throw new ApiError(500, 'SERVER_MISCONFIGURED', 'The server is not configured.');
  }

  return Object.freeze({
    spreadsheetId: props[PROPERTY_KEYS.SPREADSHEET_ID].trim(),
    firebaseProjectId: props[PROPERTY_KEYS.FIREBASE_PROJECT_ID].trim(),
    firebaseWebApiKey: props[PROPERTY_KEYS.FIREBASE_WEB_API_KEY].trim(),
    tokenCacheSeconds: readIntProperty_(props, PROPERTY_KEYS.TOKEN_CACHE_SECONDS, CONFIG_DEFAULTS.TOKEN_CACHE_SECONDS, 0, 600),
    clockSkewSeconds: readIntProperty_(props, PROPERTY_KEYS.CLOCK_SKEW_SECONDS, CONFIG_DEFAULTS.CLOCK_SKEW_SECONDS, 0, 300),
    environment: (props[PROPERTY_KEYS.ENVIRONMENT] || 'development').trim(),
  });
}

function readIntProperty_(props, key, fallback, min, max) {
  const raw = props[key];
  if (raw === undefined || raw === null || String(raw).trim() === '') return fallback;
  const value = parseInt(raw, 10);
  if (isNaN(value) || value < min || value > max) {
    console.warn('Ignoring invalid Script Property ' + key + '=' + raw + '; using ' + fallback);
    return fallback;
  }
  return value;
}
