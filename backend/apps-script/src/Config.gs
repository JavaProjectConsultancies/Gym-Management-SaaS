/**
 * Config.gs — static schema, roles and permissions, plus runtime configuration
 * read from Script Properties.
 *
 * NOTHING environment-specific is hard-coded here. Spreadsheet IDs, the
 * Firebase project ID and the API key live in Script Properties
 * (Project Settings → Script properties). See docs/BACKEND_SETUP.md.
 *
 * Apps Script shares one global scope across files. Top-level code in this
 * file only declares literals, so file load order does not matter.
 */

const APP_VERSION = '0.6.0';

/** Script Property names. */
const PROPERTY_KEYS = Object.freeze({
  SPREADSHEET_ID: 'SPREADSHEET_ID',
  FIREBASE_PROJECT_ID: 'FIREBASE_PROJECT_ID',
  FIREBASE_WEB_API_KEY: 'FIREBASE_WEB_API_KEY',
  TOKEN_CACHE_SECONDS: 'TOKEN_CACHE_SECONDS',
  CLOCK_SKEW_SECONDS: 'CLOCK_SKEW_SECONDS',
  ENVIRONMENT: 'ENVIRONMENT',
  BOOTSTRAP_PROVISION: 'BOOTSTRAP_PROVISION',
});

const CONFIG_DEFAULTS = Object.freeze({
  TOKEN_CACHE_SECONDS: 120, // 0 disables the verified-token cache
  CLOCK_SKEW_SECONDS: 60,
  LOCK_TIMEOUT_MS: 10000,
  MAX_REQUEST_BYTES: 20000,
  MAX_ID_TOKEN_LENGTH: 4096,
});

/* ------------------------------------------------------------------ */
/* Database schema (central platform spreadsheet)                      */
/* ------------------------------------------------------------------ */

const USER_ROLES = Object.freeze({
  PLATFORM_ADMIN: 'PLATFORM_ADMIN', // operates the SaaS; not tied to one gym
  GYM_OWNER: 'GYM_OWNER',
  GYM_ADMIN: 'GYM_ADMIN',
  TRAINER: 'TRAINER',
  STAFF: 'STAFF',
  MEMBER: 'MEMBER',
});

/** Setting keys: lower-case dotted identifiers, e.g. "business.timezone". */
const SETTING_KEY_PATTERN = /^[a-z][a-z0-9_.]{1,63}$/;

const USER_STATUS = Object.freeze({ ACTIVE: 'ACTIVE', INACTIVE: 'INACTIVE' });
const MEMBER_STATUS = Object.freeze({ ACTIVE: 'ACTIVE', INACTIVE: 'INACTIVE' });
const GENDERS = Object.freeze(['MALE', 'FEMALE', 'OTHER']);
const PLAN_STATUS = Object.freeze({ ACTIVE: 'ACTIVE', INACTIVE: 'INACTIVE' });
/** Stored membership status. Date-based states are computed (MembershipService.gs). */
const MEMBERSHIP_STATUS = Object.freeze({ ACTIVE: 'ACTIVE', CANCELLED: 'CANCELLED' });
/** Computed membership states, as returned by the API. */
const MEMBERSHIP_STATES = Object.freeze(['UPCOMING', 'ACTIVE', 'EXPIRING', 'EXPIRED', 'CANCELLED']);
/** A running membership is "expiring" when this many days or fewer remain. */
const MEMBERSHIP_EXPIRING_DAYS = 7;
const PAYMENT_METHODS = Object.freeze(['CASH', 'UPI', 'CARD', 'BANK_TRANSFER', 'OTHER']);
const PAYMENT_STATUS = Object.freeze({ RECORDED: 'RECORDED', VOIDED: 'VOIDED' });
/** Attendance: IN = in the gym, OUT = checked out, VOIDED = entered by mistake. */
const ATTENDANCE_STATUS = Object.freeze({ IN: 'IN', OUT: 'OUT', VOIDED: 'VOIDED' });
const GYM_STATUS = Object.freeze({ ACTIVE: 'ACTIVE', SUSPENDED: 'SUSPENDED', INACTIVE: 'INACTIVE' });

/**
 * Column types:
 *   id       — `<PREFIX>-<uuid>` generated by the backend, immutable
 *   ref      — ID of a row in another tab (or empty when `required: false`)
 *   string   — free text (trimmed, length-limited)
 *   email    — lower-cased email address
 *   enum     — one of `values`
 *   datetime — ISO-8601 UTC string, e.g. 2026-11-24T10:15:30.000Z (set by the backend)
 *   date     — calendar date YYYY-MM-DD (gym-local, no time zone)
 *   phone    — normalised phone number: optional "+" then 7–15 digits
 *
 * All columns are stored as plain text (number format "@") so Sheets never
 * auto-converts IDs, dates or numbers.
 */
const SCHEMA = Object.freeze({
  Gyms: {
    idColumn: 'Gym_ID',
    idPrefix: 'GYM',
    columns: [
      { name: 'Gym_ID', type: 'id' },
      { name: 'Gym_Name', type: 'string', required: true, maxLength: 120 },
      { name: 'Owner_UID', type: 'string', required: true, maxLength: 128 },
      { name: 'Spreadsheet_ID', type: 'string', required: false, maxLength: 128 },
      { name: 'Status', type: 'enum', required: true, values: Object.values(GYM_STATUS) },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },
  Users: {
    idColumn: 'User_ID',
    idPrefix: 'USR',
    columns: [
      { name: 'User_ID', type: 'id' },
      { name: 'Firebase_UID', type: 'string', required: true, maxLength: 128 },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: false }, // empty only for PLATFORM_ADMIN
      { name: 'Email', type: 'email', required: true, maxLength: 254 },
      { name: 'Full_Name', type: 'string', required: true, maxLength: 120 },
      { name: 'Role', type: 'enum', required: true, values: Object.values(USER_ROLES) },
      { name: 'Status', type: 'enum', required: true, values: Object.values(USER_STATUS) },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },
  Gym_Settings: {
    idColumn: 'Setting_ID',
    idPrefix: 'SET',
    columns: [
      { name: 'Setting_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Setting_Key', type: 'string', required: true, maxLength: 64, pattern: SETTING_KEY_PATTERN },
      { name: 'Setting_Value', type: 'string', required: false, maxLength: 2000 },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },
  Platform_Audit_Log: {
    idColumn: 'Log_ID',
    idPrefix: 'LOG',
    appendOnly: true,
    columns: [
      { name: 'Log_ID', type: 'id' },
      { name: 'User_ID', type: 'string', required: true, maxLength: 128 }, // User_ID, or "SYSTEM"
      { name: 'Action', type: 'string', required: true, maxLength: 64 },
      { name: 'Entity', type: 'string', required: true, maxLength: 64 },
      { name: 'Entity_ID', type: 'string', required: false, maxLength: 128 },
      { name: 'Timestamp', type: 'datetime' },
    ],
  },
});

/* ------------------------------------------------------------------ */
/* Per-gym database schema (one spreadsheet per gym)                   */
/* ------------------------------------------------------------------ */

/**
 * Each gym's operational data lives in its own spreadsheet (Gyms.Spreadsheet_ID),
 * created by initializeGymDatabases() — see GymDatabaseService.gs.
 *
 * Every per-gym table ALSO stores Gym_ID, and every read filters on it. This is
 * defence in depth: even if two gyms were ever misconfigured to share a
 * spreadsheet, one gym could not see the other's rows.
 *
 * `immutableColumns` can never be changed by an update (besides the ID and Created_At).
 */
const GYM_SCHEMA = Object.freeze({
  Members: {
    idColumn: 'Member_ID',
    idPrefix: 'MEM',
    immutableColumns: ['Gym_ID', 'Created_By'],
    columns: [
      { name: 'Member_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Full_Name', type: 'string', required: true, maxLength: 120 },
      { name: 'Phone', type: 'phone', required: true },
      { name: 'Email', type: 'email', required: false, maxLength: 254 },
      { name: 'Gender', type: 'enum', required: false, values: GENDERS },
      { name: 'Date_Of_Birth', type: 'date', required: false },
      { name: 'Address', type: 'string', required: false, maxLength: 300 },
      { name: 'Emergency_Contact_Name', type: 'string', required: false, maxLength: 120 },
      { name: 'Emergency_Contact_Phone', type: 'phone', required: false },
      { name: 'Join_Date', type: 'date', required: true },
      { name: 'Status', type: 'enum', required: true, values: Object.values(MEMBER_STATUS) },
      { name: 'Notes', type: 'string', required: false, maxLength: 1000 },
      { name: 'Created_By', type: 'string', required: true, maxLength: 128 },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
      // Phase 9 (appended so existing sheets can be upgraded in place): the
      // member's trainer — a User_ID from the central Users tab, or empty.
      { name: 'Trainer_ID', type: 'string', required: false, maxLength: 64 },
    ],
  },

  /** Phase 6: what a gym sells, e.g. "Monthly — 30 days — ₹1500". */
  Membership_Plans: {
    idColumn: 'Plan_ID',
    idPrefix: 'PLN',
    immutableColumns: ['Gym_ID', 'Created_By'],
    columns: [
      { name: 'Plan_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Plan_Name', type: 'string', required: true, maxLength: 80 },
      { name: 'Duration_Days', type: 'int', required: true },
      { name: 'Price', type: 'money', required: true },
      { name: 'Description', type: 'string', required: false, maxLength: 500 },
      { name: 'Status', type: 'enum', required: true, values: Object.values(PLAN_STATUS) },
      { name: 'Created_By', type: 'string', required: true, maxLength: 128 },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },

  /**
   * Phase 6: a member's subscription to a plan for a date range. Plan name and
   * price are SNAPSHOTS taken at sale time, so later plan edits never change
   * history. Only ACTIVE/CANCELLED is stored; upcoming/expiring/expired is
   * computed from the dates (MembershipService.gs).
   */
  Memberships: {
    idColumn: 'Membership_ID',
    idPrefix: 'MSP',
    immutableColumns: ['Gym_ID', 'Member_ID', 'Plan_ID', 'Plan_Name', 'Start_Date', 'End_Date', 'Price', 'Created_By'],
    columns: [
      { name: 'Membership_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Member_ID', type: 'ref', ref: 'Members', required: true },
      { name: 'Plan_ID', type: 'ref', ref: 'Membership_Plans', required: true },
      { name: 'Plan_Name', type: 'string', required: true, maxLength: 80 },
      { name: 'Start_Date', type: 'date', required: true },
      { name: 'End_Date', type: 'date', required: true },
      { name: 'Price', type: 'money', required: true },
      { name: 'Status', type: 'enum', required: true, values: Object.values(MEMBERSHIP_STATUS) },
      { name: 'Notes', type: 'string', required: false, maxLength: 500 },
      { name: 'Cancel_Reason', type: 'string', required: false, maxLength: 300 },
      { name: 'Created_By', type: 'string', required: true, maxLength: 128 },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },

  /**
   * Phase 7: money received against a membership. Never deleted or edited —
   * a mistake is VOIDED (with a reason) and re-entered. Receipt numbers are
   * sequential per gym and assigned inside the script lock.
   */
  Payments: {
    idColumn: 'Payment_ID',
    idPrefix: 'PAY',
    immutableColumns: [
      'Gym_ID', 'Member_ID', 'Membership_ID', 'Receipt_No', 'Amount', 'Method',
      'Payment_Date', 'Reference', 'Created_By',
    ],
    columns: [
      { name: 'Payment_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Member_ID', type: 'ref', ref: 'Members', required: true },
      { name: 'Membership_ID', type: 'ref', ref: 'Memberships', required: true },
      { name: 'Receipt_No', type: 'string', required: true, maxLength: 20 },
      { name: 'Amount', type: 'money', required: true },
      { name: 'Method', type: 'enum', required: true, values: PAYMENT_METHODS },
      { name: 'Payment_Date', type: 'date', required: true },
      { name: 'Reference', type: 'string', required: false, maxLength: 100 },
      { name: 'Notes', type: 'string', required: false, maxLength: 300 },
      { name: 'Status', type: 'enum', required: true, values: Object.values(PAYMENT_STATUS) },
      { name: 'Void_Reason', type: 'string', required: false, maxLength: 300 },
      { name: 'Created_By', type: 'string', required: true, maxLength: 128 },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },

  /**
   * Phase 8: one visit per member per gym-local day. Check_In_At / Check_Out_At
   * are server timestamps (UTC ISO). Membership_ID is the membership that covered
   * the visit, or empty when staff let the member in without one (Override_Reason
   * then explains why). Never deleted: mistakes are VOIDED with a reason.
   */
  Attendance: {
    idColumn: 'Attendance_ID',
    idPrefix: 'ATT',
    immutableColumns: ['Gym_ID', 'Member_ID', 'Membership_ID', 'Visit_Date', 'Check_In_At', 'Override_Reason', 'Created_By'],
    columns: [
      { name: 'Attendance_ID', type: 'id' },
      { name: 'Gym_ID', type: 'ref', ref: 'Gyms', required: true },
      { name: 'Member_ID', type: 'ref', ref: 'Members', required: true },
      { name: 'Membership_ID', type: 'string', required: false, maxLength: 64 },
      { name: 'Visit_Date', type: 'date', required: true },
      { name: 'Check_In_At', type: 'string', required: true, maxLength: 40 },
      { name: 'Check_Out_At', type: 'string', required: false, maxLength: 40 },
      { name: 'Status', type: 'enum', required: true, values: Object.values(ATTENDANCE_STATUS) },
      { name: 'Override_Reason', type: 'string', required: false, maxLength: 300 },
      { name: 'Void_Reason', type: 'string', required: false, maxLength: 300 },
      { name: 'Created_By', type: 'string', required: true, maxLength: 128 },
      { name: 'Created_At', type: 'datetime' },
      { name: 'Updated_At', type: 'datetime' },
    ],
  },
});

