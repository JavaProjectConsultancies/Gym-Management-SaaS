# ------------------------------------------------------------------
# Gym Management SaaS — frontend environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put server-side secrets here.
# ------------------------------------------------------------------

# Application
VITE_APP_NAME="Gym Management SaaS"
VITE_APP_ENV=development

# Google Apps Script web app endpoint (configured later)
VITE_API_BASE_URL=

# Firebase Authentication
# Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config).
# These are public web-app identifiers, NOT secrets. Never put service-account keys here.
# Required: API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID. See docs/AUTHENTICATION.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
